<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Практическая работа №1" Height="550" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" Click="MenuItemSave_Click"/>
                <Separator/>
                <MenuItem Header="Открыть" Click="MenuItemOpen_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuItemExit_Click"/>

            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="MenuItemAbout_Click"/>
            </MenuItem>
        </Menu>

        <DataGrid x:Name="dataGrid" Grid.Row="1" Margin="10" CellEditEnding="dataGrid_CellEditEnding"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Vertical" Margin="0,0,40,0">
                <TextBlock Text="Введите целое число n:" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                <TextBox x:Name="NumberOfNumbers" Width="120" TextChanged="NumberOfNumbers_TextChanged"/>
                <TextBlock Text="Ответ:" Margin="0,10,0,5" VerticalAlignment="Top"/>
                <TextBox x:Name="Answer" Width="120" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <Button Content="Решить" Click="Calc_Click" Margin="0,0,0,5"/>
                <Button Content="Создать" Click="Create_Click" Margin="0,0,0,5"/>
                <Button Content="Заполнить" Click="Fill_Click" Margin="0,0,0,5"/>
                <Button Content="Очистить" Click="Clear_Click" Margin="0,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>